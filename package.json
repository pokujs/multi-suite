{
  "name": "@pokujs/multi-suite",
  "version": "1.0.2",
  "private": false,
  "description": "A Poku plugin to run multiple independent test suites as a single, unified execution.",
  "main": "./lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokujs/multi-suite.git"
  },
  "homepage": "https://poku.io/docs/documentation/helpers/multi-suite",
  "bugs": {
    "url": "https://github.com/pokujs/multi-suite/issues"
  },
  "author": "https://github.com/wellwelwel",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wellwelwel"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=16.x.x",
    "bun": ">=1.x.x",
    "deno": ">=2.x.x"
  },
  "scripts": {
    "test": "poku test/integration",
    "test:bun": "bun poku test/integration",
    "test:deno": "deno run -A npm:poku --denoAllow=all test/integration",
    "prebuild": "rm -rf lib",
    "build": "tsc",
    "lint": "biome lint --error-on-warnings && prettier --check .",
    "lint:fix": "biome lint --write && prettier --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^25.9.1",
    "poku": "^4.3.2",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "poku": "^4.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "poku",
    "pokujs",
    "testing",
    "plugin",
    "multi-suite",
    "test-runner",
    "sequential",
    "parallel"
  ]
}
